# Local/persistent delivery copies; checkpoints are shared separately from Git.
checkpoints/

# Wild-harvest downloader metadata can embed expiring media URLs and request
# headers. Commit the sanitized candidate/fetch/hash manifests instead.
results/wild20/**/*.info.json
results/wild20/**/source_info.json

# Exact timestamp vectors and scalar traces are durable in R2 and hash-bound by
# tracked JSON manifests. Keep review images/reports in git, not redundant
# multi-megabyte binary arrays.
results/wild20/**/frame_pts.npy
results/wild20/**/*.trace.npz
results/wild20/**/timer_trace.npz

# Discovery sweeps and dense score arrays are working state, not review
# evidence. Accepted packets retain only exact selected frames, compact plots,
# hashes, and the scripts/manifests required to reproduce those selections.
results/wild20/**/jump-search/
results/wild20/**/sparse/
results/wild20/**/activity_scan/
results/wild20/**/timer_scan/
results/wild20/**/*_scan*/

# Diagnostic label tables are immutable derived data published to R2. Keep the
# compact decode report and its hashes in Git, not duplicate Parquet payloads.
results/wild20/**/labels_*.parquet

# Bulk discovery output and machine-operation logs are not public artifacts.
# The current private history contains earlier snapshots; a public release is
# exported from an allowlist rather than exposing those blobs.
results/wild/
results/env/
results/provenance/lane_logs/

# ALBERTINE-RL local datasets, fetches, and run products. Source, compact
# manifests, and synthetic fixtures remain tracked.
/albertine/studies/rl_cross_audit/data/runtime/
/albertine/studies/rl_cross_audit/data/rocket_science/local/
/albertine/studies/rl_cross_audit/data/nitrogen_rl/local/
/albertine/studies/rl_cross_audit/runs/
